# This example file is safe to commit because it contains NO real values.
# Outline of what variables collaborators need
 
# Django
SECRET_KEY=
DEBUG=True

# Leave blank for local development (same as the original ALLOWED_HOSTS = [])
ALLOWED_HOSTS=
 
# MySQL database
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
 

# WhatsApp notifications (Meta WhatsApp Cloud API)
# WA_TOKEN: permanent token generated for the system user in Business Settings
# WA_PHONE_ID: Phone number ID from API Setup in the Meta developer dashboard
# Keep real values in .env only. Never put them in this file.
WA_TOKEN=
WA_PHONE_ID=